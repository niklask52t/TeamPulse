PORT=3000
SESSION_SECRET=change-me-to-a-random-string
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE=teampulse
EVOLUTION_TIMEOUT_MS=20000
GROUP_CHAT_ID=120363xxx@g.us

# Optional: shared secret for the public Evolution webhook. When set, incoming webhook requests
# must send it as the "apikey" (or "x-webhook-secret") header, else they are rejected with 401.
# Leave empty to keep the webhook open (backwards compatible).
WEBHOOK_SECRET=

# Optional: set only when TeamPulse runs behind a reverse proxy. A number = trusted hop count,
# otherwise an IP/subnet/preset for Express "trust proxy". Leave unset when directly exposed so
# X-Forwarded-For cannot be spoofed to bypass rate limiting.
TRUST_PROXY=

# Optional: initial admin password used ONLY when the database is first created. If unset, a random
# password is generated and printed once to the server log. Must be changed on first login either way.
ADMIN_INITIAL_PASSWORD=
